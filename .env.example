# Copy to .env. Blank SAML_SETTINGS_PATH keeps the login page in setup mode.
LOCAL_AUTH_ENABLED=true
SEED_DEMO_DATA=true
SECRET_KEY=
SAML_SETTINGS_PATH=
# When SSO is enabled this must match the registered HTTPS application origin.
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Optional comma-separated signed ePPN identifiers allowed to use this pilot.
# Empty means any Purdue identity released by the approved IdP application policy.
ALLOWED_PRINCIPALS=
PORT=5000
# Shared secret used only by the locker gateway when reporting QR scans.
LOCKER_API_KEY=
